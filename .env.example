# OpenAI generation and embeddings
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-5.6-luna"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
WORKBENCH_MODEL_MODE="live"

# Redis. REDIS_URL takes precedence when provided.
# REDIS_URL="redis://localhost:6379/0"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_DB="0"
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_SSL="false"
REDIS_NAMESPACE="portfolio"

# Short-term agent checkpoints expire after 24 hours of inactivity by default.
STM_TTL_MINUTES="1440"
STM_REFRESH_TTL_ON_READ="true"

# Calibrated support-FAQ default: distance 0.2 is equivalent to similarity 0.8.
CACHE_DISTANCE_THRESHOLD="0.2"
CACHE_TTL_SECONDS="3600"
# USD per 1M tokens; override these estimates when provider pricing changes.
CACHE_LLM_INPUT_COST_PER_MILLION="0.20"
CACHE_LLM_OUTPUT_COST_PER_MILLION="1.20"
CACHE_EMBEDDING_COST_PER_MILLION="0.02"
